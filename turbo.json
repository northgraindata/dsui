{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DSUI_WEB_BASE_PATH"],
  "globalPassThroughEnv": [
    "DSUI_VERSION",
    "DSUI_CONFIG",
    "DSUI_DATA_DIR",
    "DSUI_MASTER_KEY",
    "DSUI_HOST",
    "DSUI_PORT",
    "DSUI_WEB_ROOT",
    "DSUI_SDK_ROOT",
    "DSUI_AGENT_API_KEY"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".astro/**"] },
    "dev": { "cache": false, "persistent": true },
    "@northgraindata/dsui-server#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@northgraindata/dsui-plugin-ai-agent#build"]
    },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "outputs": [] }
  }
}
