{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["DSUI_VERSION"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".astro/**"] },
    "dev": { "cache": false, "persistent": true },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": { "outputs": [] }
  }
}
