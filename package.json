{
  "name": "dsui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "check": "biome check . && turbo typecheck",
    "test": "turbo test",
    "package:npm": "bun run scripts/package-npm.ts",
    "prepare": "if [ -d .git ]; then lefthook install; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@types/bun": "^1.3.0",
    "lefthook": "^1.12.4",
    "sharp": "^0.35.4",
    "turbo": "^2.7.3",
    "typescript": "^5.9.2"
  }
}
