{
  "name": "dsui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env ./node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check . && bun run lint:css",
    "format": "biome format --write .",
    "format:check": "biome check . --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "check": "bun run lint && turbo typecheck",
    "test": "turbo test",
    "package:npm": "bun run scripts/package-npm.ts",
    "prepare": "if [ -d .git ]; then lefthook install; fi",
    "ci:adapter-sdk": "bun scripts/ci-layer.ts adapter-sdk",
    "ci:plugin-sdk": "bun scripts/ci-layer.ts plugin-sdk",
    "ci:product": "bun scripts/ci-layer.ts product",
    "package:sdk": "bun scripts/release-packages.ts",
    "changeset": "changeset",
    "version:sdk": "changeset version",
    "fixtures:build": "bun packages/ui-fixtures/src/build.ts",
    "gallery:dev": "bun run fixtures:build && bun run --filter @northgraindata/dsui-gallery gallery",
    "test:ui": "bun run fixtures:build && bun run --filter @northgraindata/dsui-gallery test:ui",
    "lint:css": "stylelint \"packages/*/src/**/*.css\"",
    "check:ui": "bun run lint && bun run test:ui"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.3.0",
    "lefthook": "^1.12.4",
    "sharp": "^0.35.4",
    "stylelint": "^18.1.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "turbo": "^2.7.3",
    "typescript": "^5.9.2",
    "yaml": "^2.8.2"
  },
  "patchedDependencies": {
    "liveline@0.0.7": "patches/liveline@0.0.7.patch"
  }
}
