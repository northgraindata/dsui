# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.12 AS build
WORKDIR /src
COPY package.json bun.lock tsconfig.json turbo.json biome.json ./
COPY apps/site ./apps/site
COPY apps/docs ./apps/docs
RUN bun install --frozen-lockfile
RUN bun run --filter @dsui/site build && bun run --filter @dsui/docs build
RUN mkdir -p /out/docs && cp -R apps/site/dist/. /out/ && cp -R apps/docs/dist/. /out/docs/

FROM nginxinc/nginx-unprivileged:1.29.1-alpine
COPY --from=build /out /usr/share/nginx/html
COPY deploy/site-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
