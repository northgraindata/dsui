# c15t consent backend. Defaults to the dsui project in astro.config.mjs; override per environment.
# PUBLIC_C15T_BACKEND_URL=https://dsui-northgraindata-com-dsui.inth.app
# PostHog project token of the `dsui` project, which also receives OSS telemetry. Leave empty to disable.
PUBLIC_POSTHOG_TOKEN=
# First-party proxy host for PostHog, for example https://t.dsui.northgraindata.com
PUBLIC_POSTHOG_HOST=
