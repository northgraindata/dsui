---
import Footer from "@/components/footer.astro";
import StarOnGithub from "@/components/ui/button-github.astro";
import IntegrationsSection from "@/components/ui/integrations-3.astro";
import NeuralNoise from "@/components/ui/neural-noise.astro";
import WhyDsui from "@/components/why-dsui.astro";
import Base from "../layouts/Base.astro";
---

<Base>
  <main class="min-h-screen bg-canvas text-foreground">
    <header
      class="sticky top-0 z-20 -mb-[72px] px-4 sm:-mb-[80px] sm:px-6 pt-4"
    >
      <nav
        class="relative mx-auto flex max-w-6xl items-center justify-between rounded-2xl border border-foreground/10 bg-canvas/70 px-3 py-3 shadow-navbar backdrop-blur-xl sm:px-4"
        aria-label="Primary navigation"
      >
        <a
          href="/"
          class="inline-flex min-h-10 items-center gap-2 rounded-lg px-2 text-lg font-semibold tracking-tight transition-colors hover:text-brand-muted"
          aria-label="dsui home"
        >
          <img
            src="/branding/logo-icon.svg"
            alt=""
            width="24"
            height="24"
            class="size-6"
          />
          dsui
        </a>
        <div class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-1 md:flex">
          <a
            class="rounded-lg px-3 py-2 text-sm text-copy transition-colors hover:bg-foreground/8 hover:text-foreground"
            href="#product">Product</a
          >
          <a
            class="rounded-lg px-3 py-2 text-sm text-copy transition-colors hover:bg-foreground/8 hover:text-foreground"
            href="#adapters">Adapters</a
          >
          <a
            class="rounded-lg px-3 py-2 text-sm text-copy transition-colors hover:bg-foreground/8 hover:text-foreground"
            href="/docs/">Documentation</a
          >
        </div>
        <div class="flex items-center gap-2">
          <a
            class="hidden h-10 items-center gap-2 rounded-lg px-3 text-copy-subtle transition-colors hover:bg-foreground/6 hover:text-foreground sm:inline-flex"
            href="https://github.com/northgraindata/dsui"
            aria-label="dsui on GitHub — 1.2k stars"
          >
            <svg
              class="size-4"
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 2C6.477 2 2 6.589 2 12.253c0 4.53 2.865 8.37 6.839 9.727.5.096.682-.22.682-.49 0-.24-.009-1.04-.014-1.886-2.782.62-3.369-1.215-3.369-1.215-.455-1.184-1.11-1.5-1.11-1.5-.908-.637.069-.624.069-.624 1.005.073 1.533 1.058 1.533 1.058.892 1.566 2.341 1.114 2.912.852.091-.665.349-1.114.635-1.37-2.22-.26-4.555-1.14-4.555-5.07 0-1.12.39-2.035 1.03-2.753-.104-.26-.446-1.306.098-2.724 0 0 .84-.276 2.75 1.052A9.35 9.35 0 0 1 12 6.93a9.35 9.35 0 0 1 2.504.348c1.91-1.328 2.748-1.052 2.748-1.052.546 1.418.202 2.464.1 2.724.64.718 1.028 1.633 1.028 2.753 0 3.94-2.339 4.807-4.566 5.063.36.32.68.95.68 1.915 0 1.383-.012 2.498-.012 2.838 0 .272.18.59.688.49A10.27 10.27 0 0 0 22 12.253C22 6.589 17.523 2 12 2Z"></path>
            </svg>
            <span class="font-mono text-xs tabular-nums">1.2k</span>
            <svg class="size-3.5 text-brand-muted" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="m12 2.7 2.83 5.73 6.32.92-4.57 4.46 1.08 6.3L12 17.14l-5.66 2.97 1.08-6.3-4.57-4.46 6.32-.92L12 2.7Z"></path>
            </svg>
          </a>
          <a
            class="hero-action inline-flex min-h-10 items-center rounded-lg bg-action-primary px-3.5 text-sm font-semibold text-foreground shadow-action-primary hover:shadow-action-primary-hover"
            href="/docs/getting-started/"
            >Get started <span class="ml-2 text-brand-softest" aria-hidden="true"
              >→</span
            ></a
          >
        </div>
      </nav>
    </header>
    <section
      id="product"
      class="relative flex min-h-screen items-center justify-center overflow-hidden px-6"
    >
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-dvh overflow-hidden"
        style="-webkit-mask-image: var(--ds-mask-hero); mask-image: var(--ds-mask-hero);"
      >
        <NeuralNoise />
      </div>
      <div class="relative z-10 w-full max-w-6xl py-32 text-center sm:py-40">
        <div class="mx-auto max-w-4xl">
          <div class="mb-7 flex justify-center"><StarOnGithub /></div>
          <h1
            class="text-balance text-6xl font-semibold tracking-tighter sm:text-8xl"
          >
            One lightweight UI for your data stack.
          </h1>
          <p
            class="mx-auto mt-6 max-w-xl text-pretty text-base leading-7 text-copy sm:text-lg"
          >
            Inspect, query, and operate the services you already run — from one
            local-first workspace.
          </p>
          <div
            class="mx-auto mt-8 flex w-full max-w-md flex-col justify-center gap-3 sm:max-w-none sm:flex-row"
          >
            <a
              class="hero-action inline-flex h-12 w-full items-center justify-center rounded-xl bg-action-primary px-6 text-sm font-semibold text-foreground shadow-action-primary hover:shadow-action-primary-hover focus-visible:ring-2 focus-visible:ring-brand-muted focus-visible:ring-offset-2 focus-visible:ring-offset-canvas focus-visible:outline-none sm:w-auto"
              href="/docs/getting-started/"
              >Get started <span
                class="hero-action-icon ml-2 text-brand-softest"
                aria-hidden="true">→</span
              ></a
            >
            <a
              class="hero-action hero-action--external inline-flex h-12 w-full items-center justify-center rounded-xl border border-brand-muted/15 bg-action-secondary px-6 text-sm font-semibold text-copy shadow-action-secondary hover:border-brand-muted/35 hover:shadow-action-secondary-hover focus-visible:ring-2 focus-visible:ring-brand-muted focus-visible:ring-offset-2 focus-visible:ring-offset-canvas focus-visible:outline-none sm:w-auto"
              href="/docs/"
              >Explore the docs <span
                class="hero-action-icon ml-2 text-brand-muted"
                aria-hidden="true">↗</span
              ></a
            >
          </div>
        </div>

        <!-- Replace the contents of this figure with the real dashboard screenshot. -->
        <figure
          class="mx-auto mt-14 w-full overflow-hidden rounded-2xl border border-brand-soft/15 bg-canvas/85 text-left"
          aria-label="Dashboard preview placeholder"
          style="-webkit-mask-image: var(--ds-mask-preview); mask-image: var(--ds-mask-preview);"
        >
          <div class="flex h-11 items-center border-b border-foreground/8 px-4">
            <div class="flex gap-1.5" aria-hidden="true">
              <span class="size-2 rounded-full bg-surface-hover"></span>
              <span class="size-2 rounded-full bg-surface-hover"></span>
              <span class="size-2 rounded-full bg-surface-hover"></span>
            </div>
            <span class="mx-auto font-mono text-[11px] text-copy-muted"
              >dsui</span
            >
            <span class="size-8" aria-hidden="true"></span>
          </div>
          <div
            class="grid aspect-[16/9] grid-cols-[minmax(9rem,20%)_1fr] bg-dashboard"
          >
            <aside class="border-r border-foreground/8 p-4 sm:p-5">
              <p class="font-mono text-[10px] tracking-[0.14em] text-copy-faint">
                WORKSPACE
              </p>
              <div class="mt-5 space-y-2">
                <div class="h-7 rounded-md bg-brand/12"></div>
                <div class="h-7 rounded-md bg-foreground/4"></div>
                <div class="h-7 rounded-md bg-foreground/4"></div>
              </div>
            </aside>
            <div class="flex items-center justify-center p-6 sm:p-10">
              <div class="text-center">
                <p
                  class="font-mono text-[11px] tracking-[0.16em] text-brand-muted/70"
                >
                  DASHBOARD PREVIEW
                </p>
                <p class="mt-3 max-w-xs text-sm leading-6 text-copy-muted">
                  Your product screenshot slots directly into this frame.
                </p>
              </div>
            </div>
          </div>
        </figure>
      </div>
    </section>
    <WhyDsui />
    <IntegrationsSection />
    <Footer />
  </main>
</Base>
