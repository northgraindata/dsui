---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "dsui — Data Stack UI",
  description = "One lightweight UI for your data stack.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f0ea" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://dsui.northgraindata.com" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
