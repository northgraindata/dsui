---
import Workspace from "./why-dsui-workspace.astro";
---

<section id="why-dsui" class="why-section px-6 py-24 sm:py-32" aria-labelledby="why-title">
  <div class="why-inner">
    <p class="why-eyebrow"><span aria-hidden="true"></span> CONNECT. EXTEND. BUILD.</p>
    <div class="why-heading">
      <h2 id="why-title">Plug into your stack.<br /><span>Build on top.</span></h2>
      <p>DSUI connects to the tools you already run. Bring them into one workspace, add AI with context across services, and build capabilities of your own.</p>
    </div>
    <Workspace />

  </div>
</section>

<style>
  .why-section { overflow: clip; background: var(--ds-color-canvas); color: var(--ds-color-foreground); scroll-margin-top: 100px; }
  .why-inner { max-width: 1152px; margin-inline: auto; }
  .why-eyebrow { display: flex; align-items: center; gap: 10px; font: 10px ui-monospace, monospace; letter-spacing: .14em; color: var(--ds-color-brand-muted); }
  .why-eyebrow > span { width: 6px; height: 6px; background: var(--ds-color-brand-muted); }
  .why-heading { display: grid; grid-template-columns: 1.4fr 1fr; gap: 80px; align-items: end; margin-top: 24px; }
  .why-heading h2 { font-size: clamp(38px, 4.8vw, 64px); font-weight: 600; line-height: 1.08; letter-spacing: -.05em; }
  .why-heading h2 > span { color: var(--ds-color-copy-subtle); }
  .why-heading > p { max-width: 380px; padding-bottom: 4px; font-size: 15px; line-height: 1.8; color: var(--ds-color-copy-subtle); text-wrap: pretty; }
  @media (max-width: 760px) { .why-heading { grid-template-columns: 1fr; gap: 24px; } .why-heading > p { max-width: 540px; font-size: 14px; } }
</style>
