---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<div class="screenshot-placeholder" role="img" aria-label={`${label}: screenshot placeholder`}>
  <div class="placeholder-grid" aria-hidden="true"></div>
  <div class="placeholder-top"><span>DSUI / {label}</span><span>SCREENSHOT PLACEHOLDER</span></div>
  <div class="placeholder-content">
    <span class="placeholder-mark"><img src="/branding/logo-icon.svg" alt="" width="40" height="40" /></span>
    <p>{title}</p>
    <span class="placeholder-description">{description}</span>
  </div>
  <div class="placeholder-bottom" aria-hidden="true"><span>OPEN SOURCE · EXTENSIBLE · YOUR INFRASTRUCTURE</span><span>↗</span></div>
</div>

<style>
  .screenshot-placeholder { position: relative; display: flex; flex-direction: column; justify-content: space-between; isolation: isolate; min-width: 0; aspect-ratio: 16 / 10; overflow: hidden; padding: clamp(16px, 3vw, 32px); background: var(--ds-color-canvas); color: var(--ds-color-copy-subtle); }
  .placeholder-grid { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(color-mix(in srgb, var(--ds-color-brand-muted) 6%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--ds-color-brand-muted) 6%, transparent) 1px, transparent 1px); background-size: 40px 40px; mask-image: radial-gradient(ellipse at center, black, transparent 75%); }
  .placeholder-top, .placeholder-bottom { display: flex; justify-content: space-between; gap: 16px; font: 9px/1.5 ui-monospace, monospace; letter-spacing: .08em; color: var(--ds-color-copy-muted); }
  .placeholder-top > span:last-child { color: var(--ds-color-copy-faint); }
  .placeholder-content { display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 28px 12px; text-align: center; }
  .placeholder-mark { display: grid; place-items: center; width: 72px; height: 72px; border: 1px dashed color-mix(in srgb, var(--ds-color-brand-muted) 30%, transparent); border-radius: 18px; background: color-mix(in srgb, var(--ds-color-brand) 5%, transparent); }
  .placeholder-content p { max-width: 520px; font-size: clamp(21px, 2.8vw, 36px); font-weight: 500; line-height: 1.2; letter-spacing: -.045em; color: var(--ds-color-copy); text-wrap: balance; }
  .placeholder-description { max-width: 400px; font-size: clamp(11px, 1.2vw, 14px); line-height: 1.7; text-wrap: balance; }
  .placeholder-bottom > span:last-child { font-size: 16px; color: var(--ds-color-brand-muted); }
  @media (max-width: 540px) { .screenshot-placeholder { aspect-ratio: 4 / 3; } .placeholder-top, .placeholder-bottom { font-size: 6px; gap: 8px; } .placeholder-content { padding: 20px 0; gap: 12px; } .placeholder-mark { width: 52px; height: 52px; border-radius: 13px; } .placeholder-mark img { width: 30px; height: 30px; } }
</style>
