---
const docsBaseUrl = import.meta.env.DEV
  ? "http://localhost:4322/docs"
  : "/docs";
const contactUrl = "https://github.com/northgraindata/dsui/discussions";

const tiers = [
  {
    id: "community",
    name: "Community",
    price: "Free",
    note: "Open source, Apache-2.0",
    cta: {
      label: "Get started",
      href: `${docsBaseUrl}/getting-started/quickstart`,
    },
    description: "For builders who want full control.",
    features: ["Self-host with npx or Docker", "All built-in adapters and core plugins", "Adapter SDK and Plugin SDK", "Community support"],
    featured: false,
  },
  {
    id: "cloud",
    name: "Cloud",
    price: "Pricing on request",
    note: "Pro plugins and managed cloud",
    cta: { label: "Talk to us", href: contactUrl },
    description: "For teams ready to hand off the operations.",
    features: ["Everything in Community", "Managed cloud hosting", "Notifications and AI diagnostics", "AI usage included", "Team access and email support"],
    featured: true,
  },
  {
    id: "enterprise",
    name: "Enterprise",
    price: "Pricing on request",
    note: "Deployed in your cloud",
    cta: { label: "Talk to us", href: contactUrl },
    description: "For organizations with their own requirements.",
    features: ["Everything in Cloud", "Deploy into your AWS, Azure or GCP", "Private networking, SSO and audit log", "Dedicated onboarding and support"],
    featured: false,
  },
] as const;

// true = included, false = not included, string = shown as text.
type Cell = boolean | string;
type Row = {
  label: string;
  hint?: string;
  values: readonly [Cell, Cell, Cell];
};
type Group = { title: string; rows: readonly Row[] };

const groups: readonly Group[] = [
  {
    title: "Platform",
    rows: [
      {
        label: "Workspace for your whole data stack",
        values: [true, true, true],
      },
      {
        label: "Built-in adapters",
        hint: "Airflow, dbt, PostgreSQL, ClickHouse, S3-compatible, DuckDB, Trino",
        values: [true, true, true],
      },
      {
        label: "Connections encrypted with your master key",
        values: [true, true, true],
      },
      { label: "Configuration in dsui.yaml", values: [true, true, true] },
      { label: "Apache-2.0 source", values: [true, true, true] },
    ],
  },
  {
    title: "Plugins",
    rows: [
      { label: "DSUI Agent", values: [true, true, true] },
      { label: "AI usage included", hint: "DSUI Agent and AI diagnostics", values: [false, true, true] },
      { label: "Service health", values: [true, true, true] },
      { label: "Monitoring", values: [true, true, true] },
      { label: "Code repository", values: [true, true, true] },
      {
        label: "Notifications",
        hint: "Slack and Discord, rules, delivery history",
        values: [false, true, true],
      },
      {
        label: "AI diagnostics",
        hint: "Evidence-based reports and draft pull requests",
        values: [false, true, true],
      },
      {
        label: "Team access",
        hint: "Teams, roles and service-level access",
        values: [false, true, true],
      },
      { label: "Early access to new Pro plugins", values: [false, true, true] },
    ],
  },
  {
    title: "Extensibility",
    rows: [
      { label: "Adapter SDK and Plugin SDK", values: [true, true, true] },
      {
        label: "Private adapters and plugins",
        hint: "Pulled from your own git and built on startup",
        values: [true, true, true],
      },
      {
        label: "Help building custom adapters and plugins",
        values: [false, false, true],
      },
    ],
  },
  {
    title: "Deployment",
    rows: [
      { label: "Self-hosted with npx or Docker", values: [true, true, true] },
      { label: "Managed cloud, hosted by us", values: [false, true, true] },
      {
        label: "Deployed into your AWS, Azure or GCP account",
        values: [false, false, true],
      },
      {
        label: "Data stays in your own cloud",
        values: ["Self-hosted", "Self-hosted", true],
      },
      {
        label: "Private networking to your services",
        values: [false, false, true],
      },
    ],
  },
  {
    title: "Security and access",
    rows: [
      { label: "Email and password sign-in", values: [false, true, true] },
      { label: "Role-based access by team", values: [false, true, true] },
      { label: "Single sign-on (SSO)", values: [false, false, true] },
      { label: "Audit log", values: [false, false, true] },
      { label: "Security review with your team", values: [false, false, true] },
    ],
  },
  {
    title: "Support",
    rows: [
      { label: "Documentation and GitHub issues", values: [true, true, true] },
      { label: "Email support", values: [false, true, true] },
      {
        label: "Dedicated support and onboarding",
        values: [false, false, true],
      },
      { label: "Custom contract and invoicing", values: [false, false, true] },
    ],
  },
];
---

<section id="pricing" class="pricing-section relative overflow-clip px-6 py-24 text-foreground sm:py-32" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl">
      <p class="mb-5 font-mono text-[11px] tracking-[0.16em] text-brand-muted">PRICING</p>
      <h2 id="pricing-title" class="text-balance text-4xl font-semibold tracking-tight sm:text-6xl">
        Open source at the core.<br />Choose how you run it.
      </h2>
      <p class="mt-6 text-pretty text-base leading-7 text-copy sm:text-lg">
        The platform and its SDKs are open source. Paid tiers add plugins built by us, hosting we manage, and deployment into your own cloud.
      </p>
    </div>

    <div class="plan-grid">
      {tiers.map((tier) => (
        <article class:list={["plan-card", { "plan-card-featured": tier.featured }]} aria-labelledby={`plan-${tier.id}`}>
          <div class="plan-icon">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              {tier.id === "community" && <path d="m8 8-4 4 4 4 M16 8l4 4-4 4 M14 4l-4 16" />}
              {tier.id === "cloud" && <path d="M7 18a5 5 0 1 1 .3-10A7 7 0 0 1 21 11a3.5 3.5 0 0 1-1 7z" />}
              {tier.id === "enterprise" && <path d="M4 21V7l8-4 8 4v14 M2 21h20 M9 21v-5h6v5 M8 8h1 M15 8h1 M8 12h1 M15 12h1" />}
            </svg>
          </div>
          <div class="plan-eyebrow"><h3 id={`plan-${tier.id}`}>{tier.name}</h3>{tier.featured && <span>MANAGED FOR YOU</span>}</div>
          <p class="plan-description">{tier.description}</p>
          <p class="plan-price">{tier.id === "community" ? "$0" : "Let’s talk"}<span>{tier.note}</span></p>
          <a class:list={["pricing-cta", { "pricing-cta-primary": tier.featured }]} href={tier.cta.href}>{tier.cta.label}<span aria-hidden="true">↗</span></a>
          <ul class="plan-features">{tier.features.map((feature) => <li><svg class="feature-check" aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 4 4L19 6" /></svg>{feature}</li>)}</ul>
        </article>
      ))}
    </div>

    <div class="pricing-scroll" tabindex="0" role="region" aria-label="Plan comparison">
      <table class="pricing-table">
        <caption class="sr-only">Compare what each DSUI plan includes</caption>
        <colgroup><col class="col-feature" /><col /><col /><col /></colgroup>
        <thead>
          <tr>
            <td class="pricing-corner"><span class="comparison-label">Plan comparison</span></td>
            {tiers.map((tier) => (
              <th scope="col" class:list={["pricing-head", { "pricing-featured": tier.featured }]}>
                <span class="tier-name">{tier.name}</span>

              </th>
            ))}
          </tr>
        </thead>
        {groups.map((group) => (
          <tbody>
            <tr class="group-row"><th scope="colgroup" colspan="4">{group.title}</th></tr>
            {group.rows.map((row) => (
              <tr>
                <th scope="row" class="feature">
                  <span>{row.label}</span>
                  {row.hint && <small>{row.hint}</small>}
                </th>
                {row.values.map((value, index) => (
                  <td class:list={{ "pricing-featured": tiers[index].featured }}>
                    {value === true ? (
                      <>
                        <svg class="yes" aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3.5 8.5 3 3 6-7" /></svg>
                        <span class="sr-only">Included</span>
                      </>
                    ) : value === false ? (
                      <>
                        <span class="no" aria-hidden="true"></span>
                        <span class="sr-only">Not included</span>
                      </>
                    ) : (
                      <span class="text">{value}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
        <tfoot>
          <tr>
            <td class="pricing-corner"></td>
            {tiers.map((tier) => (
              <td class:list={["pricing-foot", { "pricing-featured": tier.featured }]}>
                <a class:list={["pricing-cta", { "pricing-cta-primary": tier.featured }]} href={tier.cta.href}>{tier.cta.label}</a>
              </td>
            ))}
          </tr>
        </tfoot>
      </table>
    </div>

  </div>
</section>

<style>
  .plan-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin-top: 56px; border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 20%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--ds-color-copy) 20%, transparent); }
  .plan-card { padding: 36px 32px; background: var(--ds-color-canvas); }
  .plan-card + .plan-card { border-left: 1px solid color-mix(in srgb, var(--ds-color-copy) 16%, transparent); }
  .plan-card-featured { box-shadow: inset 0 2px var(--ds-color-brand-muted); }
  .plan-icon { margin-bottom: 28px; color: var(--ds-color-brand-muted); }
  .feature-check { flex-shrink: 0; width: 16px; height: 20px; color: var(--ds-color-copy-subtle); }
  .plan-eyebrow { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .plan-eyebrow h3 { font-size: 18px; font-weight: 600; }
  .plan-eyebrow > span { font: 9px ui-monospace, monospace; letter-spacing: .08em; color: var(--ds-color-brand-muted); }
  .plan-description { min-height: 48px; margin-top: 14px; font-size: 14px; line-height: 1.7; color: var(--ds-color-copy-subtle); }
  .plan-price { margin: 30px 0 24px; font-size: 36px; font-weight: 600; letter-spacing: -.04em; }
  .plan-price > span { display: block; margin-top: 8px; font-size: 12px; font-weight: 400; letter-spacing: 0; color: var(--ds-color-copy-subtle); }
  .plan-card .pricing-cta { display: flex; justify-content: space-between; width: 100%; }
  .plan-features { display: grid; gap: 15px; margin-top: 28px; padding-top: 24px; border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 12%, transparent); }
  .plan-features li { display: flex; gap: 10px; font-size: 13px; line-height: 1.6; color: var(--ds-color-copy); }
  
  @media (max-width: 900px) { .plan-grid { grid-template-columns: 1fr; } .plan-card { padding-inline: 0; } .plan-card + .plan-card { border-left: 0; border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 16%, transparent); } .plan-card-featured { box-shadow: none; } .plan-description { min-height: 0; } }

  .pricing-section {
    background: var(--ds-color-canvas);
  }
  .pricing-scroll { margin-top: 64px; overflow-x: auto; border: 0; border-radius: 0; background: var(--ds-color-canvas); }
  .pricing-scroll:focus-visible { outline: 2px solid var(--ds-color-brand-muted); outline-offset: 3px; }
  .pricing-table { width: 100%; min-width: 760px; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
  .col-feature { width: 34%; }
  .pricing-table th, .pricing-table td { text-align: left; font-weight: 400; }
  .pricing-head { padding: 24px; vertical-align: bottom; }
  .comparison-label { display: block; padding: 24px 0; font-size: 14px; color: var(--ds-color-copy-subtle); }
  .pricing-table thead th { border-bottom: 1px solid color-mix(in srgb, var(--ds-color-copy) 20%, transparent); }
  .pricing-table td:not(:first-child), .pricing-table thead th { text-align: center; }
  .pricing-table td .yes, .pricing-table td .no { margin-inline: auto; }
  .pricing-head > span { display: block; }
  .tier-name { font-size: 15px; font-weight: 500; color: var(--ds-color-brand-muted); }
  .pricing-featured { background: transparent; }
  .group-row th { position: sticky; left: 0; padding: 36px 24px 12px; font-size: 13px; font-weight: 500; letter-spacing: .01em; color: var(--ds-color-foreground); border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 12%, transparent); }
  tbody tr:not(.group-row) > * { padding: 14px 24px; border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 7%, transparent); }
  .feature { position: sticky; left: 0; z-index: 1; background: var(--ds-color-canvas); font-size: 14px; line-height: 1.5; color: var(--ds-color-copy); }
  .feature small { display: block; margin-top: 2px; font-size: 12px; line-height: 1.5; color: var(--ds-color-copy-subtle); }
  td { font-size: 14px; color: var(--ds-color-copy); }
  .yes { display: block; color: var(--ds-color-brand-hover); }
  .no { display: block; width: 10px; height: 1.5px; background: var(--ds-color-copy-faint); }
  .text { font-size: 13px; color: var(--ds-color-copy-subtle); }
  .pricing-foot { padding: 24px; border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 12%, transparent); }
  .pricing-corner { border-top: 0; }
  tfoot .pricing-corner { border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 12%, transparent); }
  .pricing-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding-inline: 20px; border: 1px solid color-mix(in srgb, var(--ds-color-brand-muted) 24%, transparent); border-radius: 10px; font-size: 14px; font-weight: 600; color: var(--ds-color-copy); transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease; }
  .pricing-cta-primary { border-color: transparent; background: var(--ds-color-brand-strong); color: var(--ds-color-foreground); }
  .pricing-cta:focus-visible { outline: 2px solid var(--ds-color-brand-muted); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .pricing-cta:not(.pricing-cta-primary):hover { background: color-mix(in srgb, var(--ds-color-foreground) 8%, transparent); color: var(--ds-color-foreground); }
    .pricing-cta-primary:hover { background: var(--ds-color-brand-deep); }
  }
  @media (max-width: 760px) { .pricing-scroll { margin-top: 44px; } .col-feature { width: 40%; } }
</style>
