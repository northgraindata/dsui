---
const integrations = [
  {
    name: "Trino",
    src: "/assets/logos/trino.svg",
    gradient:
      "from-adapter-trino/70 via-adapter-bigquery-mid/25 to-transparent",
    glow: "bg-adapter-trino-glow/18",
  },
  {
    name: "Apache Kafka",
    src: "/assets/logos/apachekafka.svg",
    gradient: "from-adapter-kafka/65 via-adapter-kafka-mid/20 to-transparent",
    glow: "bg-adapter-kafka-glow/16",
  },
  {
    name: "PostgreSQL",
    src: "/assets/logos/postgresql.svg",
    gradient: "from-adapter-postgres/70 via-brand/25 to-transparent",
    glow: "bg-adapter-postgres-glow/18",
  },
  {
    name: "MinIO",
    src: "/assets/logos/minio.svg",
    gradient: "from-brand-soft/85 via-brand/45 to-adapter-trino-glow/20",
    glow: "bg-brand-hover/30",
    featured: true,
  },
  {
    name: "BigQuery",
    src: "/assets/logos/bigquery.svg",
    gradient: "from-adapter-bigquery/75 via-brand/30 to-transparent",
    glow: "bg-adapter-bigquery-glow/18",
  },
  {
    name: "Apache Airflow",
    src: "/assets/logos/airflow.svg",
    gradient:
      "from-adapter-airflow/75 via-adapter-trino-glow/30 to-transparent",
    glow: "bg-adapter-trino-glow/18",
  },
  {
    name: "Dagster",
    src: "/assets/logos/dagster.svg",
    gradient:
      "from-adapter-dagster/75 via-adapter-dagster-mid/30 to-transparent",
    glow: "bg-adapter-dagster-glow/18",
  },
] as const;

const rows = [
  integrations.slice(0, 2),
  integrations.slice(2, 5),
  integrations.slice(5),
];
---

<section id="adapters" class="bg-canvas py-24 text-foreground sm:py-32">
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-6 sm:grid-cols-2 sm:gap-20">
    <div class="relative order-2 mx-auto w-fit sm:order-1">
      <div aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 z-0 h-40 w-[32rem] max-w-[130vw] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand/18 blur-3xl"></div>
      <div
        class="relative z-[1]"
        style="-webkit-mask-image: var(--ds-mask-integrations); mask-image: var(--ds-mask-integrations);"
      >
        {rows.map((row, rowIndex) => (
          <div class:list={["mx-auto flex w-fit justify-center gap-3", rowIndex < 2 && "mb-3"]}>
            {row.map((integration) => (
              <div
                class:list={[
                  "relative flex size-20 items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br p-px shadow-integration sm:size-24",
                  integration.gradient,
                  "featured" in integration && integration.featured && "shadow-integration-featured",
                ]}
              >
                <div class="absolute inset-px rounded-[15px] bg-canvas/95"></div>
                <div aria-hidden="true" class:list={["absolute -inset-8 rounded-full blur-2xl", integration.glow]}></div>
                <img src={integration.src} alt={integration.name} class="relative size-9 object-contain brightness-0 invert drop-shadow-integration sm:size-10" />
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="order-1 max-w-lg text-center sm:order-2 sm:text-left">
      <p class="font-mono text-[11px] tracking-[0.16em] text-brand-muted">ADAPTERS</p>
      <h2 class="mt-5 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">Your stack, one consistent interface.</h2>
      <p class="mt-5 text-pretty text-base leading-7 text-copy sm:text-lg">
        Work with the data services you already run. Each adapter brings service-specific workflows into the same focused dsui workspace.
      </p>
      <a
        class="hero-action mt-8 inline-flex h-12 items-center justify-center whitespace-nowrap rounded-xl border border-brand-muted/15 bg-action-secondary px-6 text-sm font-semibold text-copy shadow-action-secondary hover:border-brand-muted/35 hover:shadow-action-secondary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-muted focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
        href="/docs/adapters/"
      >
        Explore adapters <span class="hero-action-icon ml-2 text-brand-muted" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
