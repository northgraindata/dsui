---
import CloudPreview from "./cloud-preview.astro";
import ShaderBackground from "./ui/line-shader-homlu-ui.astro";

const cloudUrl = "https://cloud.dsui.northgraindata.com";

const points = [
  {
    title: "Nothing to run",
    icon: "M4 5h16v6H4z M4 15h16v5H4z M7 8h.01 M7 18h.01 M17 8h1 M17 18h1",
    body: "We host, upgrade and back up DSUI. You connect your services and get a workspace.",
  },
  {
    title: "Teams and sign-in",
    icon: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8 M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75",
    body: "Email and password sign-in, roles by team, and service-level access, set up for you.",
  },
  {
    title: "Pro plugins included",
    icon: "M8 3v5 M16 3v5 M6 8h12v3a6 6 0 0 1-12 0z M12 17v4",
    body: "Notifications, AI diagnostics and early access to new plugins, without wiring them yourself.",
  },
  {
    title: "AI usage included",
    icon: "m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5z",
    body: "AI usage for DSUI Agent and AI diagnostics is included in your Cloud plan.",
  },
] as const;
---

<section id="cloud" class="cloud-section bg-canvas px-6 py-24 text-foreground sm:py-32" aria-labelledby="cloud-title">
  <div class="cloud-panel mx-auto max-w-6xl">
    <div class="cloud-atmosphere" aria-hidden="true"><ShaderBackground /></div>
    <div class="cloud-intro">
    <div class="cloud-copy max-w-2xl">
      <p class="cloud-wordmark"><img src="/branding/logo-icon.svg" width="28" height="28" alt="" /><span>DSUI <span class="cloud-wordmark-label">Cloud</span></span></p>
      <h2 id="cloud-title" class="mt-5 text-balance text-4xl font-semibold tracking-tight sm:text-5xl">Your workspace.<br /><span class="cloud-heading-accent">We’ll run it.</span></h2>
      <p class="mt-6 text-pretty text-base leading-7 text-copy sm:text-lg">All your tools in one workspace. We handle hosting, upgrades and backups, so your team can get back to the data.</p>
      <div class="cloud-actions mt-8 flex flex-wrap gap-3">
        <a
          class="hero-action inline-flex h-12 items-center justify-center rounded-xl bg-action-primary px-6 text-sm font-semibold text-foreground shadow-action-primary hover:shadow-action-primary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-muted focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
          href={cloudUrl}
          data-cloud-link="section">Open DSUI Cloud <span class="hero-action-icon ml-2 text-brand-softest" aria-hidden="true">↗</span></a
        >
        <a
          class="hero-action inline-flex h-12 items-center justify-center rounded-xl border border-brand-muted/15 bg-action-secondary px-6 text-sm font-semibold text-copy shadow-action-secondary hover:border-brand-muted/35 hover:shadow-action-secondary-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-muted focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
          href="#pricing">Compare plans <span class="hero-action-icon ml-2 text-brand-muted" aria-hidden="true">→</span></a
        >
      </div>
      <p class="cloud-included">AI usage included <span aria-hidden="true">·</span> Pro plugins included</p>
    </div>

    <CloudPreview />
    </div>

    <ul class="cloud-benefits">
      {points.map((point) => (
        <li>
          <svg class="benefit-icon" aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d={point.icon} /></svg>
          <h3 class="text-base font-semibold tracking-tight">{point.title}</h3>
          <p class="mt-3 text-sm leading-6 text-copy-subtle">{point.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cloud-section { position: relative; isolation: isolate; overflow: clip; }
  .cloud-panel { position: relative; }
  .cloud-atmosphere { position: absolute; z-index: -1; pointer-events: none; inset: -200px -240px 0; opacity: .48; mask-image: linear-gradient(to bottom, transparent, black 38%, black 65%, transparent); }
  .cloud-intro { display: flex; flex-direction: column; align-items: center; gap: 64px; }
  .cloud-copy { max-width: 800px; text-align: center; }
  .cloud-copy > p:not(.cloud-wordmark):not(.cloud-included) { max-width: 560px; margin-inline: auto; }
  .cloud-wordmark { display: inline-flex; align-items: center; gap: 10px; font-size: 23px; font-weight: 600; letter-spacing: -.04em; }
  .cloud-wordmark-label { color: var(--ds-color-brand-muted); font-weight: 400; }
  .cloud-heading-accent { color: var(--ds-color-brand-muted); }
  .cloud-actions { justify-content: center; }
  .cloud-included { margin-top: 20px; font-size: 12px; color: var(--ds-color-copy-subtle); }
  .cloud-included span { margin-inline: 10px; }

  .cloud-copy h2 { margin-top: 28px; font-size: clamp(52px, 7.5vw, 96px); line-height: 1.02; letter-spacing: -.055em; }
  .cloud-benefits { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px; margin-top: 72px; padding-top: 32px; border-top: 1px solid color-mix(in srgb, var(--ds-color-copy) 16%, transparent); }
  .benefit-icon { margin-bottom: 22px; color: var(--ds-color-brand-muted); }
  @media (max-width: 900px) { .cloud-intro { gap: 48px; } .cloud-benefits { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .cloud-atmosphere { inset-inline: -120px; opacity: .3; } .cloud-benefits { gap: 32px 24px; margin-top: 48px; } }
  @media (max-width: 380px) { .cloud-benefits { grid-template-columns: 1fr; } }
</style>
