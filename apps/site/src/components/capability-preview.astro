---
import ShaderBackground from "./ui/line-shader-homlu-ui.astro";

interface Props {
  variant: "ai-diagnostics" | "team-access" | "mcp";
}
const { variant } = Astro.props;
const titles = {
  "ai-diagnostics": "AI diagnostics",
  "team-access": "Team access",
  mcp: "MCP connections",
};
---

<div class="capability-stage">
  <div class="capability-background" aria-hidden="true"><ShaderBackground /></div>
  <div class="capability-window" aria-label={`Illustrative ${titles[variant]} preview`}>
    <div class="preview-header"><span><img src="/branding/logo-icon.svg" width="18" height="18" alt="" loading="lazy" />{titles[variant]}</span></div>
    {variant === "ai-diagnostics" && <div class="preview-body">
      <p class="eyebrow">INVESTIGATION / AIRFLOW</p>
      <div class="heading-row"><h4>Daily revenue pipeline failed</h4><span class="status">Completed</span></div>
      <p class="muted">daily_revenue · transform_orders</p>
      <div class="report-summary"><span class="section-label">Root cause</span><p>The task references <code>customer_id</code>, which is missing from the source schema.</p></div>
      <div class="evidence"><span class="section-label">Technical evidence</span><p><span class="evidence-index">01</span>Task log <span class="source-label">Airflow</span></p><code class="log-line">UndefinedColumn: column "customer_id" does not exist</code><p><span class="evidence-index">02</span>Source schema <span class="source-label">PostgreSQL</span></p><div class="schema-line"><code>orders.customer_ref</code><span>Available</span></div></div>
      <div class="draft-pr"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 6v12 M16 18v-7a5 5 0 0 0-5-5 M3 3h6v6H3z M3 15h6v6H3z M13 15h6v6h-6z" /></svg><div><strong>Fix revenue source column</strong><p>Draft pull request · Ready for review</p></div><span aria-hidden="true">↗</span></div>
    </div>}
    {variant === "team-access" && <div class="preview-body access-preview">
      <p class="eyebrow">WORKSPACE SETTINGS</p><h4 class="admin-title">Users &amp; access</h4><p class="admin-description">Manage the people and permissions in your workspace.</p>
      <div class="admin-actions" aria-hidden="true"><span>Refresh</span><span>Invite people</span><span class="primary-action">＋ Create account</span></div>
      <div class="admin-tabs" aria-hidden="true"><span class="selected">Users <small>3</small></span><span>Teams <small>1</small></span></div>
      <div class="admin-toolbar" aria-hidden="true"><span>⌕ Search by name or email…</span><span>All roles ⌄</span></div>
      <div class="admin-table-wrap"><table><caption class="sr-only">Example workspace users and permissions</caption><thead><tr><th scope="col">Member</th><th scope="col">Role</th><th scope="col">Teams</th></tr></thead><tbody>{[{name:"Alex Lee",email:"alex@example.com",initials:"AL",role:"Admin"},{name:"Sam Morgan",email:"sam@example.com",initials:"SM",role:"Operator"},{name:"Jamie Rivera",email:"jamie@example.com",initials:"JR",role:"Viewer"}].map((member) => <tr><td><div class="admin-person"><span class="avatar">{member.initials}</span><span><strong>{member.name}</strong><small>{member.email}</small></span></div></td><td><span class="role-select">{member.role} ⌄</span></td><td><span class="team-select">Data Engineering ⌄</span></td></tr>)}</tbody></table><p class="table-footnote">3 of 3 members</p></div>
    </div>}
    {variant === "mcp" && <div class="preview-body authorization-preview">
      <h4 class="authorization-title">Connect “AI client” to DSUI?</h4>
      <p class="authorization-description">This application will be able to use DSUI as you, within the access you choose below. It will be sent back to <strong>localhost</strong> when you decide.</p>
      <p class="authorization-warning">Anyone can register an application under any name. Continue only if you just started this from a tool you trust.</p>
      <div class="authorization-options"><span class="section-label">Access</span><div class="permission-option"><span class="radio-mark checked" aria-hidden="true"></span><div><strong>Read only</strong><p>Look at services, resources and events.</p></div></div><div class="permission-option"><span class="radio-mark" aria-hidden="true"></span><div><strong>Read and run actions</strong><p>It can run any action you are allowed to run, without asking again.</p></div></div></div>
      <div class="authorization-services"><span class="section-label">Services (none selected means everything you can access)</span><div><span class="checkbox checked" aria-hidden="true">✓</span> PostgreSQL</div><div><span class="checkbox checked" aria-hidden="true">✓</span> Airflow</div><div><span class="checkbox" aria-hidden="true"></span> S3</div></div>
      <div class="authorization-actions" aria-hidden="true"><span class="primary-action">Allow</span><span>Deny</span></div>
    </div>}
  </div>
</div>

<style>
  .capability-stage { position: relative; isolation: isolate; display: grid; place-items: center; min-height: 480px; padding: 48px 28px; overflow: hidden; background: var(--ds-color-canvas); }
  .capability-background { position: absolute; z-index: -1; inset: -60px; pointer-events: none; opacity: .55; mask-image: linear-gradient(to bottom, transparent, black 30%, black 70%, transparent); }
  .capability-window { width: 86%; max-width: 360px; overflow: hidden; border: 1px solid #34445e; border-radius: 10px; background: #080f1c; box-shadow: 0 20px 48px #0005; text-align: left; }
  .preview-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 13px 16px; border-bottom: 1px solid #ffffff0d; color: #e0e8f5; font-size: 11px; font-weight: 500; }
  .preview-header > span:first-child { display: flex; align-items: center; gap: 8px; }
  .preview-body { padding: 22px 16px 18px; }
  .eyebrow { font: 8px ui-monospace, monospace; color: #8996aa; letter-spacing: .06em; }
  .heading-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; }
  h4 { font-size: 14px; font-weight: 500; line-height: 1.4; letter-spacing: -.025em; color: #e0e8f5; }
  .status { color: #9bcbb8; font-size: 8px; padding: 3px 6px; border: 1px solid #9bcbb833; border-radius: 4px; }
  .muted, .count { color: #8996aa; font-size: 9px; }
  .muted { margin-top: 6px; }
  .section-label { display: block; color: #a6b7ce; font-size: 9px; font-weight: 500; }
  .report-summary { margin-top: 22px; padding-left: 12px; border-left: 2px solid #93c5fd; }
  .report-summary p { margin-top: 7px; color: #c2cddd; font-size: 10px; line-height: 1.8; }
  code { color: #bfdbfe; font: 9px ui-monospace, monospace; overflow-wrap: anywhere; }
  .evidence { margin-top: 22px; }
  .evidence > p { display: flex; align-items: center; gap: 7px; margin-top: 14px; font-size: 9px; color: #c2cddd; }
  .evidence-index { color: #8996aa; font: 8px ui-monospace, monospace; }
  .source-label { margin-left: auto; color: #8996aa; font-size: 8px; }
  .log-line { display: block; padding: 10px; margin-top: 7px; border: 1px solid #ffffff0d; border-radius: 4px; color: #dba9ac; font-size: 8px; line-height: 1.8; }
  .schema-line { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 9px 0; }
  .schema-line > span { color: #9bcbb8; font-size: 8px; }
  .draft-pr { display: flex; align-items: center; gap: 10px; margin-top: 15px; padding: 12px; border: 1px solid #ffffff16; border-radius: 6px; color: #b3a6d9; }
  .draft-pr > svg { flex-shrink: 0; }
  .draft-pr > span { margin-left: auto; }
  .draft-pr strong { display: block; color: #d1dbea; font-size: 10px; font-weight: 500; }
  .draft-pr p { margin-top: 4px; color: #8996aa; font-size: 8px; line-height: 1.5; }
  .access-preview .admin-title { margin-top: 8px; font-size: 17px; }
  .admin-description { color: #8090aa; font-size: 9px; margin-top: 5px; line-height: 1.6; }
  .admin-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .admin-actions > span, .authorization-actions > span { padding: 6px 8px; border: 1px solid #223047; border-radius: 5px; color: #a5b4cc; font-size: 8px; }
  .primary-action { background: #3578f6; border-color: #3578f6 !important; color: white !important; }
  .admin-tabs { display: flex; gap: 20px; margin-top: 22px; border-bottom: 1px solid #223047; }
  .admin-tabs > span { display: flex; align-items: center; gap: 6px; padding-bottom: 10px; color: #8090aa; font-size: 10px; }
  .admin-tabs .selected { color: #eef2ff; border-bottom: 2px solid #3578f6; }
  .admin-tabs small { padding: 1px 4px; border: 1px solid #223047; border-radius: 3px; font-size: 8px; }
  .admin-toolbar { display: flex; justify-content: space-between; gap: 8px; align-items: center; margin: 16px 0 10px; color: #8090aa; font-size: 8px; }
  .admin-toolbar > span:last-child { padding: 5px 8px; border: 1px solid #223047; border-radius: 4px; white-space: nowrap; }
  .admin-table-wrap { border: 1px solid #223047; border-radius: 6px; overflow-x: auto; background: #0b1220; }
  table { width: 100%; min-width: 300px; border-collapse: collapse; text-align: left; }
  th { padding: 9px 8px; color: #8090aa; font-size: 7px; font-weight: 500; text-transform: uppercase; letter-spacing: .05em; }
  td { padding: 12px 8px; border-top: 1px solid #223047; }
  .admin-person { display: flex; align-items: center; gap: 7px; }
  .avatar { display: grid; place-items: center; flex-shrink: 0; width: 23px; height: 23px; border: 1px solid #3578f633; border-radius: 50%; background: #3578f619; color: #a9c8ff; font-size: 7px; }
  .admin-person strong { display: block; font-size: 9px; font-weight: 500; white-space: nowrap; color: #eef2ff; }
  .admin-person small { display: block; margin-top: 3px; font-size: 7px; color: #8090aa; }
  .role-select { display: block; white-space: nowrap; padding: 5px; border: 1px solid #223047; border-radius: 4px; font-size: 7px; color: #a5b4cc; }
  .team-select { font-size: 7px; color: #a5b4cc; }
  .table-footnote { padding: 10px 8px; border-top: 1px solid #223047; color: #8090aa; font-size: 8px; }
  .authorization-title { font-size: 17px; }
  .authorization-description { margin-top: 9px; color: #a5b4cc; font-size: 9px; line-height: 1.8; }
  .authorization-warning { padding: 10px; margin-top: 14px; border: 1px solid #d8b36933; border-radius: 5px; background: #d8b36908; color: #c7b58f; font-size: 8px; line-height: 1.8; }
  .authorization-options { margin-top: 20px; }
  .permission-option { display: flex; align-items: flex-start; gap: 9px; margin-top: 12px; }
  .radio-mark { flex-shrink: 0; width: 11px; height: 11px; margin-top: 2px; border: 1px solid #547399; border-radius: 50%; }
  .radio-mark.checked { background: #93c5fd; box-shadow: inset 0 0 0 2px #080f1c; }
  .permission-option strong { font-size: 10px; color: #d1dbea; font-weight: 500; }
  .permission-option p { margin-top: 4px; color: #8090aa; font-size: 8px; line-height: 1.6; }
  .authorization-services { margin-top: 20px; }
  .authorization-services > .section-label { line-height: 1.7; }
  .authorization-services > div { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: 9px; color: #c2cddd; }
  .checkbox { display: grid; place-items: center; width: 11px; height: 11px; border: 1px solid #547399; border-radius: 2px; font-size: 8px; }
  .checkbox.checked { background: #3578f6; border-color: #3578f6; color: white; }
  .authorization-actions { display: flex; gap: 8px; margin-top: 22px; }
  .capability-window:has(.access-preview) { max-width: 400px; width: 94%; }
  @media (max-width: 440px) { .capability-stage { min-height: 440px; padding: 36px 14px; } .capability-window { width: 94%; } .preview-body { padding-inline: 12px; } .preview-header { padding-inline: 12px; } }
</style>
