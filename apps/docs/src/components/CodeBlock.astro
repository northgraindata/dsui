---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang: "ts" | "tsx" | "yaml" | "bash" | "json";
  label?: string;
}

const { code, lang, label = lang } = Astro.props;
---
<div class="code-block">
  <div class="code-block-head">
    <span class="code-block-lang">{label}</span>
    <button type="button" class="copy-button" data-copy aria-label="Copy code">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
      <span>Copy</span>
    </button>
  </div>
  <Code
    code={code.trimEnd()}
    lang={lang}
    themes={{ light: "github-light", dark: "github-dark" }}
    defaultColor={false}
  />
</div>
