---
import type { Root } from "fumadocs-core/page-tree";
import { sectionsOf } from "@/lib/tree";
import Search from "./Search";

interface Props {
  tree: Root;
  pathname: string;
}

const { tree, pathname } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const landingUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : "https://dsui.northgraindata.com";
const sections = sectionsOf(tree, pathname);
---
<header class="site-header">
  <div class="site-header-inner">
    <button
      type="button"
      class="icon-button menu-button"
      aria-label="Open navigation"
      data-open-drawer
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
    <a class="brand" href={landingUrl} aria-label="DSUI home">
      <img src={`${base}/branding/logo-icon.svg`} alt="" width="24" height="24" />
      DSUI
      <span class="brand-tag">Docs</span>
    </a>
    <nav class="section-nav" aria-label="Sections">
      {sections.map((section) => (
        <a href={section.href} aria-current={section.active ? "true" : undefined}>{section.name}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button type="button" class="search-trigger" data-open-search aria-label="Search documentation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="search-label">Search</span>
        <kbd>⌘&nbsp;K</kbd>
      </button>
      <a class="icon-button" href="https://github.com/northgraindata/dsui" aria-label="DSUI on GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.76 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg>
      </a>
      <button type="button" class="icon-button" data-toggle-theme aria-label="Toggle color theme">
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" /></svg>
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
      </button>
    </div>
  </div>
</header>
<Search client:load base={base} />
<script>
  document.querySelector("[data-toggle-theme]")?.addEventListener("click", () => {
    const root = document.documentElement;
    const dark =
      root.dataset.theme === "dark" ||
      (root.dataset.theme !== "light" &&
        matchMedia("(prefers-color-scheme: dark)").matches);
    const next = dark ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("dsui-docs-theme", next);
    } catch {}
  });
  document.querySelector("[data-open-search]")?.addEventListener("click", () => {
    document.dispatchEvent(new CustomEvent("docs:search"));
  });
</script>
