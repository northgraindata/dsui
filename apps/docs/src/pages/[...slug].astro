---
import { type CollectionEntry, render } from "astro:content";
import { mdxComponents } from "@/components/mdx";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { source } from "@/lib/source";

interface Props {
  page: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
  // Generated component pages are served by adapter-sdk/components/[component].
  return source
    .getPages()
    .filter((page) => page.data._raw.digest !== "")
    .map((page) => ({
      params: {
        slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined,
      },
      props: { page: page.data._raw },
    }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const toc = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));
---
<DocsLayout
  title={page.data.title}
  description={page.data.description}
  tree={source.getPageTree()}
  toc={toc}
  editPath={page.filePath}
  markdownUrl={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${page.id === "index" ? "index" : page.id.replace(/\/index$/, "")}.md`}
>
  <Content components={mdxComponents} />
</DocsLayout>
